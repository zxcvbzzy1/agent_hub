# Shared by all IM workers and their embedded agent_flow runtime.
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=agenthub

# Server-side requirements (configure redis.conf, not application env):
# Redis >= 6.2
# appendonly yes
# appendfsync everysec
# maxmemory-policy noeviction
# Archive queues / pending bodies / deletion tombstones must not expire.
# User event snapshots: 172800s idle TTL; archive batch: 1s or 500 entries.
